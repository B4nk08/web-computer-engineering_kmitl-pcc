# ========== Shared env example (ค่าโง่ ๆ — อย่าใช้ของจริง) ==========
# คัดลอกเป็น .env แล้วแก้ค่าเอง:  cp .env.example .env

POSTGRES_USER=dummy_user
POSTGRES_PASSWORD=dummy_password_123
POSTGRES_DB=dummy_db
POSTGRES_HOST_PORT=5433

PGADMIN_DEFAULT_EMAIL=dummy@example.com
PGADMIN_DEFAULT_PASSWORD=dummy_admin
PGADMIN_HOST_PORT=5050

BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000

# Backend local (นอก Docker)
DATABASE_URL=postgres://dummy_user:dummy_password_123@localhost:5433/dummy_db?sslmode=disable
FRONTEND_URL=http://localhost:3000
GIN_MODE=debug
PORT=8080

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=72

# Google OAuth
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# AWS S3 (อัปโหลดไฟล์จาก Admin — ใส่ key จริงแล้วรีสตาร์ท backend)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# ถ้าใช้ CloudFront / custom domain (ไม่บังคับ)
AWS_S3_PUBLIC_BASE_URL=
# ถ้าใช้ MinIO / LocalStack (ไม่บังคับ)
AWS_ENDPOINT=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
