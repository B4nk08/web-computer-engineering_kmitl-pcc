# ========== Docker Compose / shared (ตัวอย่าง — อย่าใช้ของจริง) ==========
POSTGRES_USER=dummy_user
POSTGRES_PASSWORD=dummy_password_123
POSTGRES_DB=dummy_db
POSTGRES_HOST_PORT=5433

PGADMIN_DEFAULT_EMAIL=dummy@example.com
PGADMIN_DEFAULT_PASSWORD=dummy_admin
PGADMIN_HOST_PORT=5050

BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000

# Backend ใน Docker (host = ชื่อ service `db`)
DATABASE_URL=postgres://dummy_user:dummy_password_123@db:5432/dummy_db?sslmode=disable
FRONTEND_URL=http://localhost:3000
GIN_MODE=release
PORT=8080

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
